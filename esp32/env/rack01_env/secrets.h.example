#define WIFI_SSID        "nombre-de-tu-wifi"
#define WIFI_PASSWORD    "clave-de-tu-wifi"

// Endpoint de AWS IoT Core (lo entrega Juan), termina en .amazonaws.com
#define AWS_IOT_ENDPOINT "xxxxxxxxxxxxxx-ats.iot.us-east-1.amazonaws.com"

// Pega cada certificado completo, con sus lineas BEGIN/END, entre los parentesis.
static const char AWS_CERT_CA[] = R"EOF(
-----BEGIN CERTIFICATE-----
(certificado raiz de Amazon: AmazonRootCA1.pem)
-----END CERTIFICATE-----
)EOF";

static const char AWS_CERT_CRT[] = R"EOF(
-----BEGIN CERTIFICATE-----
(certificado del dispositivo rack01-env: ...-certificate.pem.crt)
-----END CERTIFICATE-----
)EOF";

static const char AWS_CERT_PRIVATE[] = R"EOF(
-----BEGIN RSA PRIVATE KEY-----
(llave privada: ...-private.pem.key)
-----END RSA PRIVATE KEY-----
)EOF";
