# Copiar a .env (está en .gitignore). NUNCA subir el .env al repo.

# "dynamo" = tabla real | "simulado" = datos de ensayo en memoria, sin AWS
MCP_DATOS=simulado

# DynamoDB (los entrega Juan: usuario IAM de SOLO LECTURA sobre la tabla)
DYNAMO_TABLE=nombre-de-la-tabla
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Servidor HTTP: http://<host>:<puerto>/mcp
MCP_HOST=0.0.0.0
MCP_PORT=8000
