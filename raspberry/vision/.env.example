# Copia este archivo a .env y completa con tus valores (el .env NUNCA va a git)

# --- AWS IoT Core ---
AWS_IOT_ENDPOINT=a1om6z0mkt0pcq-ats.iot.us-east-1.amazonaws.com
CLIENT_ID=rack01-camera
TOPIC=datacenter/rack01/camera

# --- Modelo de Edge Impulse ---
MODELO_EIM=modelo/modelo-puerta.eim
# Carpeta con las bibliotecas de Bookworm para correr el .eim en Buster.
# Déjala vacía si el sistema ya tiene glibc >= 2.34.
EIM_LIBS=/home/pi/eim-libs
# Bajo este umbral la predicción es "incierta": se publica, pero no cuenta como cambio de estado
UMBRAL_CONFIANZA=0.6

# --- Fuente de imagen: "carpeta" (fotos guardadas) o "webcam" (/dev/video0) ---
FUENTE_IMAGEN=carpeta
CARPETA_IMAGENES=imagenes_prueba
WEBCAM=/dev/video0
# Cuadros que fswebcam descarta antes de cada foto (la exposición se ajusta)
WEBCAM_SALTAR=20

# --- Tiempos (segundos) ---
CICLO_S=5
PUBLICAR_CADA_S=10

# --- Fotos guardadas en la Pi ---
CARPETA_FOTOS=fotos
MAX_FOTOS_APERTURA=200
